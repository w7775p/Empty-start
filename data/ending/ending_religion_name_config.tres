[gd_resource type="Resource" script_class="EndingReligionNameConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/ending/ending_religion_name_config.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
orthodox_name = "新鼠路撒冷"
orthodox_heretical_name = "版本发布会"
orthodox_absurd_name = "永恒星期日"
heretical_orthodox_name = "神明下岗再就业中心"
heretical_name = "地球猫猫教"
heretical_absurd_name = "真理热搜榜"
absurd_orthodox_name = "河神水务局"
absurd_heretical_name = "酪兹鼠到三"
absurd_name = "中福袋能上天堂"
orthodox_description = "鼠承诺！\n天堂的道路由金瓜子铺成，美酒在河中流淌\n每一位虔诚信徒都将享受永恒的富足"
orthodox_heretical_description = "鼠每说一句话\n就会诞生一本新的圣典\n每场直播回放都是圣典订正记录"
orthodox_absurd_description = "为终结历法纷争，鼠来宣布宇宙永远处于休息日"
heretical_orthodox_description = "神话已经过时啦！\n众神重新学习直播、剪辑和带货\n昔日的创世神，如今在鼠的直播间负责场控"
heretical_description = "全世界逐渐相信地球是一只正在熟睡的巨猫！\n地震是翻身、潮汐是呼噜\n文明的最高使命变成——让它继续睡下去"
heretical_absurd_description = "神谕每天按照热搜排名改写\n昨天的救世主今天因过气遭到除名\n连反抗神明都必须争夺流量"
absurd_orthodox_description = "丢失的东西请一律交给河神\n金斧头、银斧头、丢掉的爱情和昨天的记忆，统统排队鉴定\n河神终于考上了编制"
absurd_heretical_description = "鼠数到一，天使罢工\n数到二，圣徒集体退教\n数到三，于是众生终于获得自由"
absurd_description = "向上天堂吗？\n来，点点关注，点点粉丝牌！\n开奖结果绝对公正！"
