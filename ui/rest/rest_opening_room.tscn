[sub_resource type="Shader" id="LaptopOutlineShader"]
code = "shader_type canvas_item;\nuniform vec4 glow_color : source_color = vec4(1.0, 0.83, 0.33, 0.93);\nuniform float glow_radius = 10.0;\nvoid fragment() {\n    vec4 original = texture(TEXTURE, UV);\n    vec2 step_size = TEXTURE_PIXEL_SIZE * glow_radius;\n    float nearby = 0.0;\n    nearby = max(nearby, texture(TEXTURE, UV + vec2(step_size.x, 0.0)).a);\n    nearby = max(nearby, texture(TEXTURE, UV - vec2(step_size.x, 0.0)).a);\n    nearby = max(nearby, texture(TEXTURE, UV + vec2(0.0, step_size.y)).a);\n    nearby = max(nearby, texture(TEXTURE, UV - vec2(0.0, step_size.y)).a);\n    nearby = max(nearby, texture(TEXTURE, UV + step_size * 0.7071).a);\n    nearby = max(nearby, texture(TEXTURE, UV - step_size * 0.7071).a);\n    nearby = max(nearby, texture(TEXTURE, UV + step_size * vec2(0.7071, -0.7071)).a);\n    nearby = max(nearby, texture(TEXTURE, UV + step_size * vec2(-0.7071, 0.7071)).a);\n    float rim = max(nearby - original.a, 0.0);\n    COLOR = vec4(mix(glow_color.rgb, original.rgb, original.a), max(original.a, rim * glow_color.a));\n}\n"

[sub_resource type="ShaderMaterial" id="LaptopOutlineMaterial"]
shader = SubResource("LaptopOutlineShader")

